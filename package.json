{
  "name": "navite-tech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"styles/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run format:check",
    "shoot": "node scripts/shoot.mjs",
    "brand": "node tools/build-symbol.cjs && node tools/build-extrude.cjs && node tools/build-wordmark.cjs && node tools/build-grain.cjs && node tools/build-cubes.cjs",
    "build:art": "node tools/build-service-art.cjs && node tools/build-process-art.cjs",
    "vitals": "node scripts/vitals.mjs",
    "check:contrast": "node tools/check-contrast.cjs",
    "check:symbol": "node tools/validate-symbol.cjs",
    "check:relief": "node tools/compare-relief.cjs",
    "check:ramp": "node tools/fit-light-ramp.cjs",
    "check:filters": "node scripts/assert-no-filters.mjs",
    "check:continuity": "node scripts/verify-symbol-continuity.mjs",
    "check:scroll": "node scripts/scroll-quality.mjs",
    "check:smoothing": "node scripts/check-smoothing.mjs",
    "shoot:hero": "node scripts/shoot-hero.mjs",
    "shoot:entrada": "node scripts/shoot-entrada.mjs",
    "check:hero": "node scripts/check-hero.mjs",
    "measure:hero": "node tools/measure-hero.cjs",
    "compare:hero": "node tools/compare-hero.cjs",
    "check:problema": "node scripts/check-problema.mjs",
    "check:servicos": "node scripts/check-servicos.mjs",
    "shoot:servicos": "node scripts/shoot-servicos.mjs",
    "measure:servicos": "node tools/measure-services.cjs",
    "compare:servicos": "node tools/compare-servicos.cjs",
    "check:visuais": "node scripts/check-visuais.mjs",
    "check:processo": "node scripts/check-processo.mjs",
    "compare:processo": "node scripts/compare-processo.mjs",
    "calibrar:veu": "node scripts/calibrar-veu.mjs",
    "shoot:processo": "node scripts/shoot-processo.mjs",
    "check:contato": "node scripts/check-contato.mjs",
    "check:responsivo": "node scripts/check-responsivo.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "shoot:reduzido": "node scripts/shoot-reduzido.mjs",
    "shoot:responsivo": "node scripts/shoot-responsivo.mjs",
    "shoot:formulario": "node scripts/shoot-formulario.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.26",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@next/eslint-plugin-next": "^16.3.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.6.0",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.0"
